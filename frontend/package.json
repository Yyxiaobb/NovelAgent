{
  "name": "novel-agent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" eslint.config.js vite.config.ts vitest.config.ts \"tsconfig*.json\" .prettierrc.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" eslint.config.js vite.config.ts vitest.config.ts \"tsconfig*.json\" .prettierrc.json package.json",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
